# Copy this file to .env and fill in real values for local development.

# PostgreSQL (matches docker-compose.yml when running `docker compose up postgres redis`)
DATABASE_URL="postgresql://coffeelab:coffeelab@localhost:5432/coffeelab?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-a-random-64-byte-base64-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-byte-base64-secret"

# Public app URL, used to build links in verification/reset emails
APP_URL="http://localhost:3000"

# Seeded admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@coffeelab.dev"
SEED_ADMIN_PASSWORD="ChangeMe123!"
